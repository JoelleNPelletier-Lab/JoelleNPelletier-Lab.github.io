            }
          },
          "title3": "TRAVAUX DE VULGARISATION",
          "caption3": "Le projet de recherche de Samy Faraj, l'un de nos doctorants, a été présenté dans un épisode du podcast Recherche en cours, qui met en lumière les activités de recherche d'étudiants gradués québécois.",
          "button3": "<a data-app-btn=\"true\" href=\"https://baladoquebec.ca/recherche-en-cours/episode-1-la-resilience-de-nos-systemes\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-info\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\">ÉCOUTER L'ÉPISODE</a>",
          "media4": {
            "image": {
              "active": true,
              "src": "@PROJECT_PATH@/assets/images/news3-600x423.png",
