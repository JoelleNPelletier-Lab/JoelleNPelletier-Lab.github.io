          },
          "_tags": [
            "Theme"
          ],
          "headerAlign": "left",
          "header": "DROP-DEAD EASY WEBSITE MAKER",
          "subheader": "By John Smith posted July 30, 2015",
          "media1": {
            "image": {
              "active": true,
              "src": "images/bootstrap.png",
              "class": "mbr-figure__img",
              "width": 600
            },
            "video": {
              "class": "mbr-figure__img",
              "src": "http://www.youtube.com/embed/sOSTC6FM6Bw"
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-features1",
              "link": "",
              "size": 0
            }
          },
          "title1": "CYTOCHROME P450",
          "caption1": "Cytochromes P450 oxidize hydrophobic compounds to increase an organism's ability to eliminate these compounds. The oxidation reactions they catalyze have great potential for biocatalytic applications. To this end, we are experimentally adapting the Bacillus megaterium cytochrome P450 to catalyze industrially relevant reactions.",
          "button1": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-default\" data-toolbar=\"-mbrBtnMove\">LEARN MORE</a>",
          "media2": {
            "image": {
              "active": true,
              "src": "images/responsive.png",
              "class": "mbr-figure__img",
              "width": 600
            },
            "video": {
              "class": "mbr-figure__img",
              "src": "http://www.youtube.com/embed/sOSTC6FM6Bw"
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-features1",
              "link": "",
              "size": 0
            }
          },
          "title2": "DFRB DIHYDROFOLATE REDUCTASEs",
          "caption2": "Dihydrofolate reductases (Dfr) are essential for cell proliferation. Therefore, they are the target of the antibiotic trimethoprim. The emergence of an alternative Dfr, Dfr type B (DfrB), confers insurmountable resistance to trimethoprim. We investigate the evolution and function of this enzyme by combining bioinformatics and experimental methods to inform our design of DfrB-specific inhibitors.",
          "button2": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-default\">LEARN MORE</a>",
          "media3": {
            "image": {
              "active": true,
              "src": "images/google-fonts.png",
              "class": "mbr-figure__img",
              "width": 600
            },
            "video": {
              "class": "mbr-figure__img",
              "src": "http://www.youtube.com/embed/sOSTC6FM6Bw"
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-features1",
              "link": "",
              "size": 0
            }
          },
          "title3": "DIHYDROFOLATE REDUCTASES",
          "caption3": "Dihydrofolate reductases (Dfr) are essential for cell proliferation. Therefore, they are the target of the antibiotic trimethoprim. The emergence of an alternative Dfr, Dfr type B (DfrB), confers insurmountable resistance to trimethoprim. We investigate the evolution and function of this enzyme by combining bioinformatics and experimental methods to inform our design of DfrB-specific inhibitors.",
          "button3": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-default\">LEARN MORE</a>",
          "media4": {
            "image": {
              "active": true,
              "src": "images/unlimited-websites.png",
              "class": "mbr-figure__img",
              "width": 600
            },
            "video": {
              "class": "mbr-figure__img",
              "src": "http://www.youtube.com/embed/sOSTC6FM6Bw"
            },
            "iconFont": {
              "class": "mbr-iconfont mbr-iconfont-features1",
              "link": "",
              "size": 0
            }
          },
          "title4": "SEROLOGICAL COVID-19 PROJECT",
          "caption4": "In collaboration with the research laboratories of Jean-François Masson (U. of Montreal) and Denis Boudreau (U. Laval), with the help of organizations such as Instruments Scientifiques Affinité, Héma-Québec and many other collaborators, we are currently developing a combined ELISA and SPR (Surface Plasmon Resonance) approach to quantify and characterize antibodies against SARS-CoV-2.",
          "button4": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-default\">LEARN MORE</a>",
          "media5": {
            "image": {
              "active": true,
              "src": "images/blocks.png",
