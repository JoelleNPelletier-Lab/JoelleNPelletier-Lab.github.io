              "link": "",
              "size": 0
            }
          },
          "title4": "ARTICLES RÉCENTS",
          "caption4": "'Indigo Formation as a Predictor of Non-Native Aromatic Hydroxylation in Cytochrome P450 BM3' a été publié dans ACS Catalysis. \n<br>_________________________\n<br>'From binding to catalysis: emergence of a rudimentary enzyme conferring intrinsic antibiotic resistance' a été publié dans Molecular Biology and Evolution.<br>",
          "button4": "<a data-app-btn=\"true\" href=\"https://scholar.google.com/citations?view_op=list_works&amp;hl=fr&amp;hl=fr&amp;user=FYazIkcAAAAJ&amp;sortby=pubdate\" class=\"mbr-buttons__btn btn btn-wrap btn-xs-lg btn-success\" data-toolbar=\"-mbrBtnMove\" target=\"_blank\">LIRE LES ARTICLES</a>",
          "media5": {
            "image": {
              "active": true,
